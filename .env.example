# Database
DATABASE_URL=postgres://geo_admin:YOUR_PASSWORD_HERE@localhost:5432/geoesg_aeco
POSTGRES_USER=geo_admin
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE
POSTGRES_DB=geoesg_aeco

# Logging
RUST_LOG=debug

# Carbon Mapper STAC API Token
CARBON_MAPPER_TOKEN=YOUR_TOKEN_HERE

# Telegram Alerting
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Sensor Pointing (optional, defaults to conservative Tanager-1 values)
# SENSOR_ROLL_DEG=7.0
# SENSOR_PITCH_DEG=2.0

# NASA EMIT Fallback (GHG Center STAC)
EMIT_ENABLED=true
EMIT_STAC_URL=https://ghgcenter.upc.nasa.gov/api/stac
EMIT_POLL_INTERVAL_SECS=43200
